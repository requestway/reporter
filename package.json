{
  "name": "@requestway/reporter",
  "version": "0.1.0",
  "description": "Report x402 payment events from your Node app to Requestway. A reporter, not a payment library.",
  "keywords": [
    "x402",
    "payments",
    "analytics",
    "ai-agents",
    "usdc",
    "requestway"
  ],
  "homepage": "https://github.com/requestway/reporter#readme",
  "bugs": "https://github.com/requestway/reporter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/requestway/reporter.git"
  },
  "license": "MIT",
  "author": "Requestway",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint:package": "publint --strict && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run lint:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.19.43",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "~4.0.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
